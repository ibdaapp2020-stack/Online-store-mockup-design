rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'ADMIN';
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (userDoc().role == 'STAFF' || userDoc().role == 'ADMIN');
    }

    function publicProduct() {
      return resource.data.active == true;
    }

    function isOrderOwner() {
      return signedIn()
        && resource.data.customer.customerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'CUSTOMER'
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow get: if isAdmin() || publicProduct();
      allow list: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/store {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/counters {
      allow read, write: if isAdmin();
    }

    match /settings/bootstrap {
      allow read, write: if isAdmin();
    }

    match /customers/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow create: if signedIn() && request.auth.uid == id;
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == id
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      allow delete: if isAdmin();
    }

    match /orders/{id} {
      allow get: if isAdmin() || isOrderOwner();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appointments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /employees/{id} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin();
    }

    match /logins/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if isAdmin() || isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /corrections/{id} {
      allow read: if isAdmin() || isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /mailLog/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
