ADMIN_USERNAME=propharm
ADMIN_PASSWORD=change-me
MEDICAL_API_URL=http://127.0.0.1:5180

# sqlite = החנות החיה הנוכחית. firebase-test = אמולטור/סביבת בדיקה. firebase-live = אסור בלי אישור.
DATA_SOURCE=sqlite

# Firebase Console → Project settings
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=

# Firebase Console → Project settings → Service accounts → Generate new private key
# לשמור מחוץ לגיט, למשל C:\secrets\pro-pharm-adminsdk.json
GOOGLE_APPLICATION_CREDENTIALS=

# כתיבה ל-Firebase
FIREBASE_MIGRATE_CONFIRM=
FIREBASE_LIVE=
FIREBASE_COLLECTION_PREFIX=staging_

# אמולטור בדיקות
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=
