{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "medical-shop": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ],
      "bindings": [
        {
          "type": "service",
          "service": "medical-api",
          "format": "url",
          "env": "MEDICAL_API_URL"
        }
      ]
    },
    "medical-api": {
      "root": ".",
      "framework": "express",
      "entrypoint": "server/index.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "medical-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "medical-shop"
      }
    }
  ]
}
